{
  "name": "ksforge-sentinel",
  "version": "0.1.0",
  "private": true,
  "description": "The official Discord companion for KSForge.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/src/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "commands:deploy": "tsx src/deploy-commands.ts"
  },
  "dependencies": {
    "discord.js": "^14.17.2",
    "dotenv": "^17.0.0",
    "pino": "^9.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
